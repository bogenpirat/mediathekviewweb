# MediathekViewWeb — deployment configuration
#
#   cp .env.sample .env      then edit, then:  docker compose up -d --build
#
# Every setting below is optional; the defaults shown are what you get if the line stays
# commented out. This file is read by docker-compose.yaml, which passes the values into the
# application container.
#
# Value parsing is strict (see server/config.ts):
#   - booleans accept true/false/on/off/0/1 (case insensitive); anything else aborts startup
#   - integers accept digits only; anything else aborts startup
#   - an empty value counts as "not set" and falls back to the default
# A typo here stops the container from booting rather than being silently ignored.


# ─── Deployment shape ────────────────────────────────────────────────────────────────────────

# Subfolder the app is served from behind a reverse proxy. Keep the trailing slash.
# This is compiled into the client bundle, so changing it requires `--build`, and it must match
# the subfolder in your Apache/nginx ProxyPass.
#BASE_PATH=/mediathek/

# Host port the app is published on, bound to 127.0.0.1 so only a local reverse proxy reaches it.
# Point your ProxyPass (both the http:// and ws:// lines) at this port.
#APP_PORT=8000


# ─── Application ─────────────────────────────────────────────────────────────────────────────

# Download and index the filmliste. Leave on for a normal deployment: with it off the search
# index is never populated. Turn off only for a second instance that shares another's index.
#INDEX=true

# Watch party (synchronised playback). Off disables the /ws/party socket and the party API.
#WATCH_PARTY=true

# Indexer worker processes. Default is min(4, cpu count).
#WORKER_COUNT=4

# Extra Node arguments for the indexer workers, comma separated.
#WORKER_ARGS=--max-old-space-size=2048

# Impressum details, shown in the app's contact dialog. The defaults are placeholders
# ("Max Mustermann"), so set these if the instance is publicly reachable.
#CONTACT_NAME=
#CONTACT_STREET=
#CONTACT_POSTCODE=
#CONTACT_CITY=
#CONTACT_MAIL=

# Served verbatim at /ads.txt. Leave empty to serve nothing.
#ADS_TEXT=

# Path INSIDE the container to an HTML fragment injected before </head> (analytics snippets and
# similar), e.g. INJECT_HTML_PATH=/mediathekviewweb/inject.html
# WARNING: if the file is missing the server exits immediately and the container crash-loops,
# so mount it into the container in docker-compose.yaml before setting this.
#INJECT_HTML_PATH=


# ─── Valkey ──────────────────────────────────────────────────────────────────────────────────

# Logical database number used for the indexer state and the content-length/subtitle caches.
#VALKEY_DB=2

# Only needed if you point the app at a secured Valkey. The bundled one has no auth.
#VALKEY_USER=
#VALKEY_PASSWORD=


# ─── Set by docker-compose.yaml, not here ────────────────────────────────────────────────────
#
# These are read by the server but fixed by the compose file, so setting them in this file has
# no effect. Change them in docker-compose.yaml if you really need to:
#
#   OPENSEARCH_HOST / OPENSEARCH_PORT   pinned to the `opensearch` service
#   VALKEY_HOST     / VALKEY_PORT       pinned to the `valkey` service
#   WEBSERVER_PORT                      the container-internal port; use APP_PORT above instead
#   DATA_DIRECTORY                      backed by the `mediathekviewweb` volume; changing it
#                                       would orphan the downloaded filmliste
#
#
# ─── Client development only ─────────────────────────────────────────────────────────────────
#
# The Vite dev server reads its own file at client/.env, not this one:
#
#   VITE_API_PROXY_TARGET=http://localhost:8000/   backend the dev server proxies to
#   VITE_BASE_PATH=/mediathek/                     subfolder for `npm run dev` / `npm run build`
#
# Running the server on the host for development also needs the opensearch and valkey `ports:`
# entries in docker-compose.yaml uncommented.
